<?xml version="1.0" encoding="utf-8"?>
<!--
  Animasi masuk aktivitas.

  Dipakai lewat Nav.open()/Nav.close(). Angka & alasannya:

  Durasi 160 ms. Emil-design-eng: "UI animations should stay under 300ms" dan
  "a 180ms dropdown feels more responsive than a 400ms one". 160 ms cukup untuk
  menghilangkan potongan keras, cukup cepat untuk tidak terasa sebagai jeda.

  Interpolator decelerate (ease-out), BUKAN ease-in. Emil-design-eng: "Never use
  ease-in for UI animations. It starts slow, which makes the interface feel
  sluggish." Yang dilihat pengguna adalah layar yang MASUK, jadi yang datang
  harus cepat lalu melambat.

  Skala dari 0.98 ke 1.0, bukan dari 0. Emil-design-eng: "Never animate from
  scale(0)" — memunculkan dari nol terlihat seperti kerusakan, bukan gerakan.

  Alpha mulai 0.25, bukan 0.0. Ini khusus domain Cyclocomp: MainActivity adalah
  layar MEREKAM yang dibaca sesaat saat mengayuh. Fade dari nol membuat angka
  kecepatan butuh waktu untuk bisa dibaca; mulai dari 0.25 membuat angka sudah
  terbaca pada ~40 ms sementara gerakannya tetap terasa. Layar sekunder
  (Riwayat, Pengaturan, Ringkasan) tidak dibaca sesaat, jadi nilai ini aman
  untuk semuanya.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="160"
        android:fromAlpha="0.25"
        android:toAlpha="1.0"
        android:interpolator="@android:anim/decelerate_interpolator" />
    <scale
        android:duration="160"
        android:fromXScale="0.98"
        android:toXScale="1.0"
        android:fromYScale="0.98"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:interpolator="@android:anim/decelerate_interpolator" />
</set>

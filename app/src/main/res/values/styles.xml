<resources>
    <!--
      Tema gelap, gaya Strava: hitam pekat, kartu abu-gelap membulat, satu aksen
      oranye. Huruf memakai Barlow Condensed (angka) + Barlow (label) yang dibundel
      di assets/fonts supaya tampil sama di semua versi Android, bukan bergantung
      font sistem.
    -->
    <style name="AppTheme" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- label kecil di atas angka: huruf besar, renggang, abu -->
    <style name="Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- nilai sedang (baris metrik) -->
    <style name="ValueSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- nilai besar (angka lap) -->
    <style name="ValueBig">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- teks bilah status -->
    <style name="StatusBar">
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- tombol utama: kapsul oranye, teks gelap -->
    <style name="ActionBtnPrimary">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>

    <!-- tombol sekunder: kapsul gelap, teks putih -->
    <style name="ActionBtn">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
    </style>

    <!-- tautan kecil di bilah atas -->
    <style name="TinyBtn">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>

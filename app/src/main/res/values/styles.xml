<resources>
    <!--
      Tema gelap, gaya Strava: hitam pekat, kartu abu-gelap membulat, satu aksen
      cyan. Huruf memakai Barlow Condensed (angka) + Barlow (label) yang dibundel
      di assets/fonts supaya tampil sama di semua versi Android, bukan bergantung
      font sistem.

      Dasar Material, BUKAN Holo. Sebabnya: Holo membuat Switch "HIDUP" biru dan
      dialog abu-biru - dua warna yang tidak ada di palet ini, sehingga widget
      bawaan sistem terlihat seperti berasal dari aplikasi lain. Material
      membiarkan kita mengatur warna widget lewat atribut colorControl*, jadi
      sakelar, dialog, dan kotak centang ikut aksen cyan.

      Semua tombol aplikasi sudah memakai drawable sendiri (@drawable/bg_btn*),
      jadi perpindahan tema tidak mengubah tampilan tombol.
    -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorForeground">@color/value</item>

        <!-- warna utama & sekunder untuk teks bawaan -->
        <item name="android:textColorPrimary">@color/value</item>
        <item name="android:textColorSecondary">@color/label</item>
        <item name="android:textColorHint">@color/label</item>

        <!-- aksen cyan, bukan biru bawaan Material -->
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/card</item>
        <item name="android:colorPrimaryDark">@color/bg</item>

        <!-- Switch / CheckBox / garis fokus: ikut palet -->
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/dot_off</item>
        <item name="android:colorControlHighlight">@color/accent_soft</item>
        <item name="android:colorButtonNormal">@color/card2</item>

        <!-- garis pemisah bawaan -->
        <item name="android:divider">@color/divider</item>
        <item name="android:dividerHeight">@dimen/hairline</item>
    </style>

    <!--
      Dialog gelap. Tanpa ini, AlertDialog memakai dialog abu-biru bawaan Holo -
      satu-satunya warna di aplikasi yang tidak berasal dari palet. Latar dan
      teksnya diikat ke token supaya dialog ikut palet seperti layar lain.

      Catatan: atribut ini hanya bisa dipakai dari XML (android:theme pada
      <activity> atau tema induk). Dialog yang dibangun lewat
      new AlertDialog.Builder(activity) otomatis mewarisi tema activity, jadi
      gaya ini cukup satu kali di sini.
    -->
    <style name="AppTheme.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@color/card</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/value</item>
        <item name="android:textColorSecondary">@color/label</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/dot_off</item>
    </style>

    <!--
      Satuan di samping angka (km, km/jam, m, kcal, bpm, W).

      Kenapa TextView terpisah, bukan ikut dalam string angka: kalau satuan
      menempel di string ("12,5 km/jam"), satu-satunya cara mengubah warna atau
      ukurannya adalah mewarnai sebagian string - dan kalau bahasa berganti
      (values-en), posisi satuan bisa pindah. TextView terpisah membuat satuan
      bisa diatur sendiri warnanya (label, resesif) dan ukurannya (caption),
      sehingga angka tetap yang paling menonjol.

      Ukuran text_caption (13sp), bukan 14sp seperti mockup: tangga ukuran huruf
      aplikasi sudah punya 13sp untuk peran "satuan/keterangan" (dipakai GradeUnit
      dan SpeedUnit). Menambah 14sp akan membuat tiga nilai berturut-turut 13-14-15
      yang tidak bisa dibedakan mata - itu bising, bukan hierarki. Selisih 1sp
      tidak terlihat; hierarki datang dari WARNA.
    -->
    <style name="ValueUnit">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- label kecil di atas angka: huruf besar, renggang, abu -->
    <style name="Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- nilai sedang (baris metrik) -->
    <style name="ValueSmall">
        <item name="android:textSize">@dimen/text_value_s</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- nilai besar (angka lap) -->
    <style name="ValueBig">
        <item name="android:textSize">@dimen/text_value_l</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- angka utama di baris daftar: dominan, tapi tidak sebesar angka lap —
         daftar harus tetap bisa memuat banyak baris. -->
    <style name="ValueRow">
        <item name="android:textSize">@dimen/text_value_row</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- teks bilah status -->
    <style name="StatusBar">
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!--
      Tombol IKON di bilah atas (Riwayat, Pengaturan, gembok).

      Kenapa ikon, bukan teks "RIWAYAT / PENGATURAN": di layar 320dp, dua
      tombol teks 48dp memakan hampir seluruh lebar bilah atas dan memaksa
      status "MEREKAM · GPS ±5 m" terpotong jadi "MEREKAM ·…". Ikon 48dp
      menyingkat separuh lebarnya, dan target sentuhnya tetap 48dp - ambang
      aksesibilitas tidak turun sedikit pun.

      Latarnya bg_btn_secondary: sama dengan tombol sekunder lain, termasuk
      keadaannya yang non-aktif (garis memudar) - jadi gembok terkunci
      terbaca "mati" tanpa perlu kode tambahan.
    -->
    <style name="IconBtn">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">@dimen/gap_roomy</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      Tombol UTAMA (MULAI / JEDA / LANJUT, dan kartu gambar di layar Bagikan).

      Isi aksen penuh + teks gelap: satu-satunya tombol di layar yang berisi
      warna, jadi perhatian langsung jatuh ke sana. Yang membuatnya menonjol
      adalah WARNA dan BOBOT, bukan ukuran huruf yang berbeda drastis.

      Ukuran 20sp, bukan 22sp seperti mockup: mockup dirancang untuk layar
      390dp, sementara HP pemilik (Xperia E1 Dual) hanya 320dp lebar. Pada
      320dp, "BERHENTI" di tombol paling sempit (bobot 1 dari 1:1,5:1) hanya
      dapat ~78dp - 22sp akan terpotong jadi "BERHE…". 20sp masih masuk dan
      tetap berada di tangga ukuran huruf aplikasi.
    -->
    <style name="ActionBtnPrimary">
        <item name="android:textSize">@dimen/text_btn_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/gap_snug</item>
        <item name="android:paddingRight">@dimen/gap_snug</item>
    </style>

    <!--
      Tombol SEKUNDER (LAP, Tutup, Bagikan GPX, ...).

      Garis tepi, bukan isi. Dulu berisi card2 - hampir sama terangnya dengan
      latar kartu, jadi di layar Ringkasan ada empat tombol abu yang semuanya
      terlihat sama pentingnya padahal hanya satu yang paling sering dipakai.
      Outline membuat hierarki terbaca dari JARAK, bukan dari selisih abu-abu
      yang samar.
    -->
    <style name="ActionBtn">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <!-- Label lebih panjang dari tombol (mis. "PENGATURAN" di layar sempit)
             dipotong dengan "…", bukan terpotong bisu di tepi. -->
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/gap_tight</item>
        <item name="android:paddingRight">@dimen/gap_tight</item>
    </style>

    <!--
      Tombol BAHAYA (BERHENTI, hapus gowes).

      Garis dan teks merah, isi transparan. Kalau tombol ini berisi warna pekat
      seperti tombol MULAI, keduanya terlihat setara - padahal satu memulai dan
      satu lagi mengakhiri perjalanan. Outline merah membuatnya jelas terbaca
      sebagai jalur keluar tanpa bersaing dengan tombol utama.
    -->
    <style name="ActionBtnDanger">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/gap_tight</item>
        <item name="android:paddingRight">@dimen/gap_tight</item>
    </style>

    <!--
      Isi teks tombol BERHENTI (T-08).

      Sama dengan ActionBtnDanger kecuali latarnya transparan. Kenapa perlu
      varian terpisah: bar progres tahan-untuk-berhenti harus bertumpuk DI DALAM
      tombol, tapi Button adalah TextView dan tidak bisa punya anak. Jadi tombol
      BERHENTI dipecah - FrameLayout menggantikan latar (garis danger) dan
      menampung bar progres, sementara Button di atasnya hanya mengurus teks.

      Kalau latar Button ini tidak transparan, ia menutupi bar progres dan
      progresnya tidak pernah terlihat - persis masalah yang T-08 datang untuk
      menyelesaikan.
    -->
    <style name="ActionBtnDangerText">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/gap_tight</item>
        <item name="android:paddingRight">@dimen/gap_tight</item>
    </style>

    <!-- Nilai di sisi kanan baris pengaturan (T-11).
         Sengaja warnanya @color/value (putih), bukan @color/label: nilai adalah
         yang paling sering dicari pengguna di layar ini, dan keterangan di
         sebelahnya memang sudah abu. Kalau keduanya abu, pengguna harus membaca
         seluruh baris untuk tahu mana yang mana. -->
    <style name="SettingValue">
        <item name="android:textColor">@color/value</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- tautan kecil di bilah atas -->
    <style name="TinyBtn">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/gap_normal</item>
        <item name="android:paddingRight">@dimen/gap_normal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ===== judul seksi (eyebrow) =====
         Rata kiri, huruf besar, jarak huruf lebar. Dulu ditulis inline di empat
         layout dengan pelacakan BERBEDA (0,22 di halaman Detail/Lap/Pengaturan,
         0,18 di header grup) — peran sama, perlakuan beda. Sekarang satu gaya.

         Bedanya dengan Label: Label untuk metrik yang RATA TENGAH dan rapat (0,14),
         supaya angka dan satuannya menempel. Eyebrow rata kiri jadi lebih renggang. -->
    <style name="SectionLabel">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:paddingLeft">@dimen/gap_snug</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- sama, tapi oranye: menandai seksi yang sedang berjalan (lap aktif) -->
    <style name="SectionLabelAccent" parent="SectionLabel">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- ===== isi pil tanjakan =====
         PillGlyph hanya untuk tanda ♥ detak jantung (panah gradien sudah digantikan
         GradeRoad, jadi namanya tidak lagi "GradeArrow"). -->
    <style name="PillGlyph">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/accent_soft</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="GradeValue">
        <item name="android:textSize">@dimen/text_body_m</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="GradeUnit">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== angka kecepatan dominan =====
         Ukuran dasarnya besar, tapi tingginya dibatasi ruang yang tersedia oleh
         AutoFitText supaya tidak terpotong di layar pendek atau landscape. -->
    <style name="SpeedHero">
        <item name="android:textSize">@dimen/text_speed</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SpeedUnit">
        <item name="android:textSize">@dimen/text_body_s</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== baris pengaturan ===== -->
    <style name="SettingTitle">
        <item name="android:textSize">@dimen/text_body_m</item>
        <item name="android:textColor">@color/value</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingSummary">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/label</item>
        <!-- Jarak judul→ringkasan. Sengaja BUKAN hairline: hairline (1dp) adalah
         ketebalan GARIS, memakainya sebagai jarak menyisakan 1dp sehingga dua baris
         nempel dan terbaca satu blok. gap_snug (4dp) memberi napas tanpa memisah. -->
    <item name="android:layout_marginTop">@dimen/gap_snug</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- tanda "ada isinya" di ujung baris pengaturan -->
    <style name="Chevron">
        <item name="android:textSize">@dimen/text_chevron</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:paddingLeft">@dimen/gap_normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- teks penjelas (daftar kosong) -->
    <style name="EmptyText">
        <item name="android:textSize">@dimen/text_body_s</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>

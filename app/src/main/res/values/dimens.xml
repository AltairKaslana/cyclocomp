<?xml version="1.0" encoding="utf-8"?>
<!--
  SATU skala jarak untuk semua layar. Nama berdasarkan PERAN, bukan angka, supaya
  kalau skalanya perlu diubah nanti namanya tetap benar.

  Sebelumnya tidak ada berkas ini: nilai 14dp, 10dp, 4dp, 2dp, 7dp ditulis inline
  di masing-masing layout, dan setiap layar memilih sendiri — itu tanda tidak ada
  sistem. Sekarang semua ambil dari sini.

  Basis: 4dp, dengan dua nilai setengah (2dp) untuk celah sangat rapat seperti
  angka ke satuannya.
-->
<resources>

    <!-- ===== jarak ===== -->
    <dimen name="gap_tight">2dp</dimen>      <!-- angka ke satuannya, ikon ke teks -->
    <dimen name="gap_snug">4dp</dimen>       <!-- label ke nilai, tepi dalam kartu -->
    <dimen name="gap_cozy">6dp</dimen>       <!-- judul seksi ke isinya -->
    <dimen name="gap_normal">8dp</dimen>     <!-- jarak antar blok kecil -->
    <dimen name="gap_loose">10dp</dimen>     <!-- jarak antar kartu -->
    <dimen name="gap_roomy">12dp</dimen>     <!-- padding dalam kartu -->
    <dimen name="screen_edge">14dp</dimen>   <!-- tepi layar -->
    <dimen name="gap_wide">16dp</dimen>      <!-- padding baris pengaturan -->
    <dimen name="gap_spacious">24dp</dimen>  <!-- jarak antar wilayah -->

    <!-- ===== tinggi komponen ===== -->
    <dimen name="top_bar_h">48dp</dimen>
    <dimen name="btn_action_h">64dp</dimen>

    <!-- Target sentuh minimum. Sebelumnya tombol RIWAYAT/PENGATURAN di bilah atas
         hanya 40dp — di atas sepeda yang bergerak dengan sarung tangan itu terlalu
         kecil. 48dp adalah ambang aksesibilitas. -->
    <dimen name="touch_target_min">48dp</dimen>

    <dimen name="pill_h">30dp</dimen>
    <dimen name="metrics_card_h">96dp</dimen>

    <!-- Tinggi peta live di halaman SEKILAS, di bawah kartu metrik (angka km).
         Strip ringkas: rute yang sudah dilalui sebagai thumbnail. -->
    <dimen name="glance_map_h">120dp</dimen>

    <!-- pembatas vertikal antar kolom metrik -->
    <dimen name="divider_short">34dp</dimen>
    <dimen name="divider_lap">42dp</dimen>
    <dimen name="divider_lap_small">28dp</dimen>

    <!-- Tinggi minimum peta rute di layar Ringkasan. Diperlukan karena layar itu
         sekarang bisa digulung: tanpa minHeight, peta (berat 1) bisa terukur nol
         saat konten lebih tinggi dari layar, dan rute tak terlihat sama sekali. -->
    <dimen name="route_map_min">160dp</dimen>

    <dimen name="rec_dot">7dp</dimen>
    <dimen name="hairline">1dp</dimen>
    <dimen name="hold_bar_h">4dp</dimen>     <!-- bar progres tahan-untuk-berhenti (T-08) -->
    <dimen name="text_hint_tiny">10sp</dimen> <!-- keterangan kecil di dalam tombol (TAHAN) -->
    <dimen name="dot_radius">2dp</dimen>

    <!-- GradeRoad: ruas jalan miring. Ukuran dipilih supaya ruas jalan yang sudah
         diputar maksimal (32 derajat) tetap utuh di dalam view — kalau lebih kecil,
         ujung jalan terpotong tepat saat tanjakan curam, jadi informasi hilang justru
         saat paling dibutuhkan. -->
    <dimen name="grade_road_w">24dp</dimen>
    <dimen name="grade_road_h">18dp</dimen>

    <!-- ===== sudut lengkung =====
         Kartu membulat sedang, kapsul penuh. Satu nilai per peran. -->
    <dimen name="radius_card">14dp</dimen>
    <dimen name="radius_pill">20dp</dimen>
    <dimen name="radius_capsule">30dp</dimen>
    <dimen name="radius_thumb">10dp</dimen>
    <dimen name="radius_chip_small">10dp</dimen>

    <!-- ===== Riwayat v2 ===== -->
    <!-- Sisi thumbnail rute di baris daftar. 64dp cukup untuk mengenali bentuk
         perjalanan tanpa memakan lebar yang dibutuhkan tanggal dan jarak. -->
    <dimen name="ride_thumb">64dp</dimen>
    <!-- Tinggi batang tujuh hari; sengaja pendek agar kartu mingguan tidak
         mendorong daftar gowes keluar layar. -->
    <dimen name="week_bars_h">40dp</dimen>

    <!-- ===== ukuran huruf =====
         SATU tangga, dipakai semua layar. Nama per peran supaya kalau skalanya
         diubah namanya tetap benar.

         Sebelumnya 12 nilai dengan LIMA langkah berturut-turut di bawah 1,15x
         (11→12→13→14→15→17): mata tidak bisa membedakannya, jadi itu bising,
         bukan hierarki. Kini 8 nilai dan setiap langkah >= 1,15x:
         11 → 13 (1,18x) → 15 (1,15x) → 20 (1,33x) → 24 (1,20x)
             → 28 (1,17x) → 36 (1,29x) → 112.

         Peran yang dulu punya nilai sendiri (caption 12, body 14, body_m 15,
         btn_primary 17, empty 18) sekarang berbagi satu nilai; yang membuat
         hierarki adalah WARNA, BOBOT, dan jarak — bukan selisih 1sp. -->
    <dimen name="text_label">12sp</dimen>      <!-- eyebrow seksi, label metrik -->
    <dimen name="text_caption">13sp</dimen>    <!-- satuan, keterangan -->
    <dimen name="text_body_s">13sp</dimen>     <!-- teks penjelas -->
    <dimen name="text_body">15sp</dimen>       <!-- teks biasa -->
    <dimen name="text_body_m">15sp</dimen>     <!-- judul baris pengaturan -->
    <dimen name="text_empty">15sp</dimen>      <!-- pesan daftar kosong -->
    <dimen name="text_btn_primary">20sp</dimen><!-- tombol utama; menonjol dari warna + tebal -->
    <dimen name="text_chevron">20sp</dimen>    <!-- tanda › di pengaturan, glif tombol tutup -->
    <dimen name="text_value_s">32sp</dimen>    <!-- nilai metrik sedang -->
    <dimen name="text_value_row">28sp</dimen>  <!-- angka utama di baris daftar -->
    <dimen name="text_value_l">36sp</dimen>    <!-- nilai besar -->
    <dimen name="text_speed">176sp</dimen>     <!-- angka kecepatan dominan -->

    <!-- Titik indikator halaman (layar Bagikan). Sebelumnya ukuran dan celahnya
         dihitung manual dari density di ShareActivity.buatTitik(), jadi satu-satunya
         jarak di aplikasi yang tidak lewat berkas ini. -->
    <dimen name="dot_page">8dp</dimen>
    <dimen name="dot_page_gap">6dp</dimen>
    <!-- T-15: sisi satu kotak pada pola latar pratinjau kartu transparan.
         Dipilih selebar titik halaman supaya pola terlihat sebagai tekstur,
         bukan sebagai grid yang ikut bersaing dengan isi kartu. -->
    <dimen name="checker_cell">8dp</dimen>

    <!-- R-06: tinggi minimum satu baris kisi Detail saat landscape.
         Kenapa ada: di portrait tinggi baris datang dari layout_weight (kartu
         mengisi sisa layar, lima baris terbagi rata). Di landscape, kisi dibungkus
         ScrollView supaya tidak ada yang terpotong - dan anak ScrollView diukur
         tanpa batas, jadi weight tidak punya arti di sana. Tanpa minHeight, lima
         baris bisa menyusut sampai angka dan labelnya saling menempel.
         56dp cukup untuk Label (12sp) + ValueBig (36sp) + jeda di antaranya. -->
    <dimen name="grid_row_h_land">56dp</dimen>

    <!-- R-06: lebar maksimum baris tombol aksi saat landscape.
         Kenapa ada: bobot 1 : 1,5 : 1 dirancang untuk lebar 320dp. Di landscape
         yang lebarnya hampir dua kali itu, bobot yang sama membuat tombol MULAI
         menjadi bidang kosong selebar 270dp - hurufnya terdorong ke tengah dan
         tombolnya terbaca seperti spasi, bukan sebagai tombol. Membatasi lebar
         baris mempertahankan proporsi yang dimaksud bobot tersebut. -->
    <dimen name="action_row_w">420dp</dimen>
</resources>

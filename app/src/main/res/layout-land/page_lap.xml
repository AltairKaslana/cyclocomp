<?xml version="1.0" encoding="utf-8"?>
<!--
  Halaman 3 "LAP" - varian LANDSCAPE (R-06).

  Perbedaannya dengan portrait: portrait menumpuk kartu lap berjalan di atas
  daftar lap selesai, dan keduanya harus berbagi setinggi layar. Di landscape
  tingginya hanya sekitar setengah portrait, jadi tumpukan itu membuat daftar
  lap selesai - yang justru butuh tinggi paling banyak - mendapat ruang paling
  sedikit. Landscape unggul di LEBAR, jadi keduanya dipindah ke dua kolom
  menyamping: lap berjalan di kiri, daftar selesai di kanan setinggi penuh.

  SEMUA id dan tag "num" identik dengan portrait. MainActivity memanggil
  findViewById() tanpa memeriksa null, jadi satu id hilang = aplikasi mati tepat
  saat layar diputar. Ini diperiksa oleh verifikator, bukan diasumsikan.

  Catatan penting soal lapCard: induknya SENGAJA tetap LinearLayout vertikal.
  MainActivity.applyLapCardMode() mengatur tinggi dan berat lapCard lewat
  LinearLayout.LayoutParams - kalau induknya dibuat horizontal, "berat" akan
  berarti LEBAR dan kartunya bisa terukur nol tinggi. Karena itu kolom kanan
  adalah LinearLayout vertikal dan lapCard tetap anak terakhirnya.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_edge"
    android:paddingRight="@dimen/screen_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ===== kiri: lap yang sedang berjalan ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLapTitle"
                style="@style/SectionLabelAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/gap_snug"
                android:paddingBottom="@dimen/gap_normal"
                android:text="@string/lap_current" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="@dimen/gap_roomy"
                android:paddingBottom="@dimen/gap_roomy">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:id="@+id/lblL0" android:text="@string/label_distance" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_tight"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:baselineAligned="false">
                            <TextView android:id="@+id/tvLapDist" style="@style/ValueBig"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,00"/>
                            <TextView android:id="@+id/unL0" style="@style/ValueUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="@dimen/gap_tight"
                                android:text="@string/unit_km" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap"
                        android:layout_gravity="center_vertical" android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:id="@+id/lblL1" android:text="@string/label_lap_time" />
                        <TextView android:id="@+id/tvLapTime" style="@style/ValueBig"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0:00" />
                <TextView android:id="@+id/unL1" style="@style/ValueUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/gap_tight"
                    android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
                    android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
                    android:layout_marginTop="@dimen/gap_loose" android:layout_marginBottom="@dimen/gap_loose"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:id="@+id/lblL2" android:text="@string/label_lap_avg" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_tight"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:baselineAligned="false">
                            <TextView android:id="@+id/tvLapAvg" style="@style/ValueSmall"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,0"/>
                            <TextView android:id="@+id/unL2" style="@style/ValueUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="@dimen/gap_tight"
                                android:text="@string/unit_speed" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                        android:layout_gravity="center_vertical" android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:id="@+id/lblL3" android:text="@string/label_lap_moving" />
                        <TextView android:id="@+id/tvLapMoving" style="@style/ValueSmall"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0:00" />
                <TextView android:id="@+id/unL3" style="@style/ValueUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/gap_tight"
                    android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== kanan: lap yang sudah selesai =====
             Kolom vertikal, dan lapCard tetap anak LinearLayout vertikal -
             lihat catatan di kepala berkas ini. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/gap_loose"
            android:orientation="vertical">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/gap_snug"
                android:paddingBottom="@dimen/gap_cozy"
                android:text="@string/lap_done" />

            <!--
              Kartu "LAP SELESAI" (T-08b). Tingginya diatur dari kode lewat
              applyLapCardMode(): mengecil pas di sekeliling pesan kosongnya kalau
              belum ada lap selesai, mengisi ruang yang tersisa kalau sudah ada.
            -->
            <LinearLayout
                android:id="@+id/lapCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <ListView
                    android:id="@+id/lapList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/divider"
                    android:dividerHeight="1dp"
                    android:paddingLeft="@dimen/screen_edge"
                    android:paddingRight="@dimen/screen_edge" />

                <!-- Pesan kosong ada DI DALAM kartu, bukan di bawahnya. -->
                <TextView
                    android:id="@+id/lapEmpty"
                    style="@style/EmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="@dimen/gap_wide"
                    android:text="@string/lap_none"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

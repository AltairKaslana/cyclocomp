<!--
  Titik status "GPS bermasalah" (T-07).

  Dipakai kalau sinyal GPS hilang total: angka yang tampil tidak bisa
  dipercaya, dan itu harus terbaca SEBELUM pengguna membaca satu angka pun.
  danger (merah) dipilih karena di palet aplikasi merah sudah berarti
  "jalur keluar / berhenti" - dan berhenti memang langkah yang wajar kalau
  GPS mati di tengah gowes.

  Bentuknya identik dengan rec_dot; hanya warnanya yang beda. Tiga berkas
  terpisah (bukan satu berkas + tint lewat kode) supaya warnanya tetap lewat
  token @color dan bisa dibaca langsung dari resource tanpa menjalankan
  aplikasi.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/danger" />
</shape>

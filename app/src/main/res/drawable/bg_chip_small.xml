<?xml version="1.0" encoding="utf-8"?>
<!-- Chip kecil di baris Riwayat (LAP / KOMUTER). Sengaja lebih kecil dari
     chip layar Sensor: ia menempel pada baris daftar, bukan menjadi pilihan
     utama, jadi tidak boleh berebut perhatian dengan angka jarak. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/card2" />
    <stroke android:width="1dp" android:color="@color/stroke_ctrl" />
    <corners android:radius="@dimen/radius_chip_small" />
</shape>

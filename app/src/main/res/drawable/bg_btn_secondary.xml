<?xml version="1.0" encoding="utf-8"?>
<!--
  Tombol SEKUNDER (LAP, Tutup, Bagikan GPX, Riwayat, ...).

  Kenapa garis tepi, bukan isi: dulu tombol sekunder berisi card2 - hampir sama
  terangnya dengan latar kartu. Akibatnya di layar Ringkasan ada empat tombol
  berisi abu yang semua kelihatan sama pentingnya, padahal hanya satu yang
  paling sering dipakai. Outline membuat hierarki terbaca dari JARAK, bukan
  hanya dari perbedaan abu-abu yang samar.

  Tekanan: isi card_pressed (tetap transparan + garis), jadi tombol tetap
  terlihat "masih outline" saat ditekan - tidak berubah jadi tombol lain.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_pressed" />
            <stroke android:width="1.5dp" android:color="@color/stroke_ctrl" />
            <corners android:radius="@dimen/radius_capsule" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/card_disabled" />
            <corners android:radius="@dimen/radius_capsule" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/stroke_ctrl" />
            <corners android:radius="@dimen/radius_capsule" />
        </shape>
    </item>

</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Riwayat: daftar rekaman. Kalau kosong, pesannya TENGAH layar supaya terbaca
  sebagai keadaan, bukan teks yang tersesat di atas.

  Dulu pesan ini memakai gaya Label — yang dirancang untuk label metrik (pelacakan
  huruf 0,14, rata tengah). Untuk pesan berdiri sendiri itu salah peran: hurufnya
  jadi terlalu renggang dan warnanya abu muda. Sekarang gaya EmptyText sendiri.

  T-10 (B8): bilah atas dengan judul + tombol kembali.
  Sebelumnya layar ini memakai setTitle() saja, tapi tema aplikasi adalah
  NoActionBar - jadi judul itu tidak pernah terlihat dan tidak ada tombol kembali
  sama sekali. Satu-satunya jalan keluar adalah tombol kembali sistem, yang tidak
  terlihat di perangkat tanpa tombol navigasi layar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/gap_roomy"
        android:paddingRight="@dimen/screen_edge">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconBtn"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/SectionLabelAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/gap_normal"
            android:text="@string/title_history" />
    </LinearLayout>

    <!-- ===== T-19: total tujuh hari terakhir =====
         Ditaruh di ATAS daftar, bukan di bawah: yang paling sering dicari orang
         yang membuka Riwayat adalah "sejauh mana aku minggu ini", dan daftar
         gowes bisa puluhan baris. Menjawabnya di bawah daftar berarti menjawab
         setelah pengguna menggulir melewati semua rekaman lama.

         Kartunya sendiri disembunyikan dari kode kalau belum ada gowes dalam
         tujuh hari terakhir - bukan ditampilkan dengan "0,00 km". Kartu berisi
         nol mengklaim sesuatu yang belum diketahui pengguna, sementara daftar
         di bawahnya sudah jelas kosong.

         Tingginya wrap_content, jadi kartu ini tidak mengambil ruang daftar
         saat disembunyikan maupun saat tampil sebagai satu baris ringkas. -->
    <LinearLayout
        android:id="@+id/weekCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gap_normal"
        android:layout_marginRight="@dimen/gap_normal"
        android:layout_marginTop="@dimen/gap_normal"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/gap_wide"
        android:paddingRight="@dimen/gap_wide"
        android:paddingTop="@dimen/gap_roomy"
        android:paddingBottom="@dimen/gap_roomy"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/weekText"
            style="@style/SettingSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/gap_normal">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/empty"
            style="@style/EmptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="@dimen/text_empty"
            android:text="@string/history_empty" />
    </FrameLayout>
</LinearLayout>

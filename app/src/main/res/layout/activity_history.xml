<?xml version="1.0" encoding="utf-8"?>
<!--
  Riwayat: kartu tujuh hari + daftar rekaman. Kalau kosong, ikon dan pesannya
  TENGAH layar supaya terbaca sebagai keadaan, bukan teks yang tersesat di atas.

  N-04: kartu mingguan sekarang menampilkan jarak besar, jumlah gowes/waktu,
  dan tujuh batang per hari. Ditaruh di ATAS daftar karena pertanyaan yang
  paling sering dibawa orang ke layar ini adalah "sejauh mana aku minggu ini";
  daftar gowes bisa puluhan baris, jadi jawaban di bawahnya berarti pengguna
  harus menggulir melewati semua rekaman lama dulu.

  Kartunya disembunyikan dari kode kalau belum ada gowes dalam jendela itu -
  bukan ditampilkan dengan "0,00 km" dan tujuh batang kosong. Angka nol
  mengklaim sesuatu yang belum diketahui pengguna, sementara daftar di
  bawahnya sudah menjelaskan keadaannya.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/gap_roomy"
        android:paddingRight="@dimen/screen_edge">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconBtn"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/SectionLabelAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/gap_normal"
            android:text="@string/title_history" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weekCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gap_normal"
        android:layout_marginRight="@dimen/gap_normal"
        android:layout_marginTop="@dimen/gap_normal"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingLeft="@dimen/gap_wide"
        android:paddingRight="@dimen/gap_wide"
        android:paddingTop="@dimen/gap_roomy"
        android:paddingBottom="@dimen/gap_roomy"
        android:baselineAligned="false">

        <TextView
            style="@style/SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_week_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_cozy"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/weekDist"
                style="@style/ValueBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:tag="num" />

            <TextView
                style="@style/GradeUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/gap_snug"
                android:layout_marginBottom="@dimen/gap_snug"
                android:text="@string/unit_km" />

            <TextView
                android:id="@+id/weekText"
                style="@style/SettingSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:paddingLeft="@dimen/gap_normal"
                android:gravity="end|bottom"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Tujuh batang, urut lama ke hari ini. Isinya digambar WeekBars. -->
        <id.cyclocomp.WeekBars
            android:id="@+id/weekBars"
            android:layout_width="match_parent"
            android:layout_height="@dimen/week_bars_h"
            android:layout_marginTop="@dimen/gap_loose" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/gap_normal">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/gap_spacious">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:src="@drawable/ic_history" />

            <TextView
                style="@style/EmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_normal"
                android:gravity="center"
                android:textSize="@dimen/text_empty"
                android:text="@string/history_empty" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

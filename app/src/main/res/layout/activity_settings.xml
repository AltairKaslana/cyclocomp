<?xml version="1.0" encoding="utf-8"?>
<!--
  Pengaturan berkelompok dalam kartu, bukan daftar rata.
  Baris dibangun di SettingsActivity supaya judul + ringkasan nilai selalu sinkron.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_edge"
        android:paddingRight="@dimen/screen_edge"
        android:paddingTop="@dimen/gap_normal"
        android:paddingBottom="@dimen/gap_spacious">

        <TextView
            style="@style/SectionLabelAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/gap_roomy"
            android:text="@string/settings_title" />

        <LinearLayout
            android:id="@+id/groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

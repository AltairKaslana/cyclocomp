<?xml version="1.0" encoding="utf-8"?>
<!-- Baris pengaturan yang membuka dialog pilihan -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingLeft="@dimen/gap_wide" android:paddingRight="@dimen/gap_roomy"
    android:paddingTop="@dimen/gap_roomy" android:paddingBottom="@dimen/gap_roomy">

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView
            android:id="@+id/title"
            style="@style/SettingTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/summary"
            style="@style/SettingSummary"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/Chevron"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar Bagikan: preview kartu yang bisa digeser kiri-kanan (pola Strava),
  dengan baris aksi di bawahnya. Dipilih kartunya dulu, baru aksi:
  simpan ke galeri / bagikan gambar / bagikan GPX.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- kepala: judul + tombol tutup -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvShareTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_centerInParent="true"
            android:text="@string/share_pager_title"
            android:textColor="@color/value"
            android:textSize="@dimen/text_body_m"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btnShareClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/label"
            android:textSize="20sp"
            android:background="?android:attr/selectableItemBackground" />
    </RelativeLayout>

    <!-- nama kartu yang sedang tampil -->
    <TextView
        android:id="@+id/tvCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:textColor="@color/label"
        android:textSize="@dimen/text_body"
        android:includeFontPadding="false"
        android:maxLines="2" />

    <!-- preview: geser kiri-kanan -->
    <id.cyclocomp.CardPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:contentDescription="@string/card_variant_map" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:contentDescription="@string/card_variant_story" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <!-- latar papan catur supaya transparansi stempel terlihat -->
                <ImageView
                    android:id="@+id/img2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:background="#20242A"
                    android:contentDescription="@string/card_variant_clear" />
            </FrameLayout>
        </LinearLayout>
    </id.cyclocomp.CardPager>

    <!-- penanda halaman: tiga titik -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />

    <!-- status saat kartu sedang dibuat -->
    <TextView
        android:id="@+id/tvGenerating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="@string/share_generating"
        android:textColor="@color/label"
        android:textSize="@dimen/text_body"
        android:includeFontPadding="false" />

    <!-- baris aksi, persis di bawah gambar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnCardSave"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_action_h"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/share_action_save" />

        <Button
            android:id="@+id/btnCardShare"
            style="@style/ActionBtnPrimary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_action_h"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/share_action_share" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnCardCopy"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_action_h"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/share_action_copy" />

        <Button
            android:id="@+id/btnCardGpx"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_action_h"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/share_action_gpx" />
    </LinearLayout>
</LinearLayout>

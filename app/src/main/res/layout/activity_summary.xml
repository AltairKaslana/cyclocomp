<?xml version="1.0" encoding="utf-8"?>
<!-- Ringkasan setelah gowes: rute + angka akhir + bagikan GPX. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== bilah atas TETAP =====
         Satu-satunya elemen di layar ini yang TIDAK ikut digulir. Alasannya: jalan
         keluar tidak boleh membutuhkan gulir.

         T-09: dulu di sini ada tombol TUTUP berisi aksen selebar tombol utama -
         paling menonjol di layar, padahal ia aksi paling jarang dipakai. Sekarang
         ia tombol ikon X 48dp abu, sama dengan tombol ikon di bilah atas layar
         utama: terbaca sebagai jalan keluar tanpa bersaing dengan tombol utama
         (Bagikan kartu) di bawah. Target sentuhnya tetap 48dp.

         Tombol TUTUP kedua yang dulu ada di PALING BAWAH isi gulir sudah dibuang.
         Dua tombol bertuliskan "Tutup" di satu layar adalah label ganda - dan yang
         di bawah butuh menggulir melewati peta, metrik, lap, kalori, dan 10 tombol
         RPE hanya untuk keluar. Yang di bilah atas tidak ikut digulir, jadi selalu
         ada. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/screen_edge"
        android:paddingRight="@dimen/screen_edge">

        <ImageButton
            android:id="@+id/btnTopClose"
            style="@style/IconBtn"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <!--
      Isi dibungkus ScrollView + fillViewport. Alasannya TERUKUR, bukan selera:
      tinggi TETAP layar ini ≈ 484dp (dihitung dari dimens: judul + tanggal + kartu
      metrik + 3 tombol), sedangkan layar landscape ponsel hanya 360-400dp. Sebelum
      ini satu-satunya elemen elastis adalah peta (berat 1), jadi di layar pendek
      peta mengecil sampai nol SEMENTARA tombol STRAVA / Bagikan kartu / Bagikan GPX /
      TUTOP terdorong keluar layar — TUTUP tidak bisa dijangkau sama sekali.

      fillViewport menjaga berat 1 tetap bekerja di layar tinggi (peta mengisi ruang
      sisa), dan minHeight di peta mencegah ia kolaps total di layar pendek.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_edge"
        android:paddingRight="@dimen/screen_edge"
        android:paddingTop="@dimen/gap_tight">

    <TextView
        style="@style/SectionLabelAccent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/summary_title" />

    <TextView
        android:id="@+id/tvWhen"
        style="@style/EmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/gap_loose" />

    <id.cyclocomp.TileMapView
        android:id="@+id/route"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/route_map_min"
        android:background="@drawable/bg_card" />

    <!-- angka utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap_roomy"
        android:paddingBottom="@dimen/gap_roomy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_distance" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvDist" style="@style/ValueBig"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,00"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_km" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_moving" />
                <TextView android:id="@+id/tvMoving" style="@style/ValueBig"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0:00:00" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
            android:layout_marginTop="@dimen/gap_loose" android:layout_marginBottom="@dimen/gap_loose"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_avg" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvAvg" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,0"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_speed" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_max" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvMax" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,0"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_speed" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_elev" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvElev" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_m" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
            android:layout_marginTop="@dimen/gap_loose" android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/gap_loose">

            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/label_total" />
            <TextView android:id="@+id/tvTotal"
                style="@style/ValueSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingLeft="@dimen/gap_cozy" android:tag="num" android:text="0:00:00" />
        </LinearLayout>
    </LinearLayout>


        <!-- ===== kalori & daya (selalu tampil) =====
             Dua angka ini sengaja berdampingan: kalori TANPA daya terlihat seperti
             angka ajaib. Dengan watt rata-rata terlihat, pengguna bisa menilai
             sendiri apakah perkiraannya masuk akal untuk gowes yang baru dilakukan. -->
        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
            android:layout_marginTop="@dimen/gap_loose" android:layout_marginBottom="@dimen/gap_loose"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_kcal" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvKcal" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num"
    android:maxLines="2" android:text="0"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_kcal" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_avg_power" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvWatts" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num"
    android:text="0"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_w" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== detak jantung (hanya kalau sensor mengirim data) =====
             Wadah ini disembunyikan SELURUHNYA dari kode kalau GPX tidak memuat satu
             pun nilai hr - bukan dikosongkan, supaya tidak ada baris hampa yang
             membuat kartu terasa bolong. -->
        <LinearLayout
            android:id="@+id/hrRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
                android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
                android:layout_marginTop="@dimen/gap_loose" android:layout_marginBottom="@dimen/gap_loose"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView style="@style/Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/label_hr_avg" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_tight"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">
                        <TextView android:id="@+id/tvHrAvg" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num"
    android:text="0"/>
                        <TextView style="@style/ValueUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/gap_tight"
                            android:text="@string/unit_bpm" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                    android:layout_gravity="center_vertical" android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView style="@style/Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/label_hr_max" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_tight"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">
                        <TextView android:id="@+id/tvHrMax" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num"
    android:text="0"/>
                        <TextView style="@style/ValueUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/gap_tight"
                            android:text="@string/unit_bpm" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    <!-- lap -->
    <LinearLayout
        android:id="@+id/lapWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_roomy"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLapCount"
            style="@style/SectionLabelAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Baris lap dibuat di kode dan masuk ke sini. Sengaja dipisah dari kartu
             lapWrap supaya header tvLapCount tidak ikut terbuang saat daftar dibersihkan. -->
        <LinearLayout
            android:id="@+id/lapRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ===== penilaian sesudah gowes =====
         Dua hal yang TIDAK bisa dihitung aplikasi saat pengguna sedang mengayuh:
         apakah ini perjalanan komuter, dan seberapa berat rasanya. Strava punya
         keduanya (commute + perceived_exertion) dan keduanya dinilai SETELAH
         berkendara, jadi wadahnya sendiri - tidak dicampur ke kartu metrik.

         RPE memakai 10 tombol kecil, bukan SeekBar: dengan SeekBar pengguna harus
         memutuskan "berapa" secara abstrak; dengan angka 1..10 ia memilih tingkat
         yang sudah punya nama. Setiap pilihan langsung tersimpan, tanpa tombol
         SIMPAN terpisah - satu ketukan lebih sedikit, dan tidak ada keadaan
         "sudah pilih tapi lupa simpan". -->
    <LinearLayout
        android:id="@+id/afterCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingLeft="@dimen/gap_roomy"
        android:paddingRight="@dimen/gap_roomy"
        android:paddingTop="@dimen/gap_roomy"
        android:paddingBottom="@dimen/gap_roomy">

        <TextView
            android:id="@+id/tvRpeTitle"
            style="@style/SectionLabelAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rpe_title" />

        <TextView
            android:id="@+id/tvRpeSum"
            style="@style/EmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_tight"
            android:paddingBottom="@dimen/gap_cozy"
            android:text="@string/rpe_sum" />

        <!-- Baris angka 1..10 dibuat di kode; wadahnya di sini supaya tingginya
             mengikuti jumlah tombol, bukan tinggi tetap yang menyisakan ruang hampa. -->
        <LinearLayout
            android:id="@+id/rpeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvRpeClear"
            style="@style/EmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_snug"
            android:text="@string/rpe_clear"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginTop="@dimen/gap_cozy"
            android:layout_marginBottom="@dimen/gap_cozy"
            android:background="@color/divider" />

        <CheckBox
            android:id="@+id/swCommute"
            style="@style/CheckRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_commute"
            android:buttonTint="@color/checkbox_tint" />
    </LinearLayout>

    <!-- Kartu gambar adalah jalur utama (paling sering dipakai untuk dibagikan),
         jadi dapat baris sendiri selebar penuh. GPX dan Tutup di baris berikutnya. -->
    <Button
        android:id="@+id/btnStrava"
        style="@style/ActionBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_action_h"
        android:layout_marginTop="@dimen/gap_roomy"
        android:text="@string/btn_strava_upload" />

    <Button
        android:id="@+id/btnShareCard"
        style="@style/ActionBtnPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_action_h"
        android:layout_marginTop="@dimen/gap_loose"
        android:text="@string/btn_share_card" />

    <!-- Simpan PNG ke galeri: kartu yang sama seperti yang dibagikan, tapi
         mendarat di Pictures/Zylo supaya bisa diedit/ditempel di aplikasi foto. -->

    <!--
      T-09: baris bawah cuma satu tombol - Bagikan GPX, selebar penuh.

      Dulu di sini ada tombol TUTUP kedua di sebelahnya. Dua tombol bertuliskan
      "Tutup" di satu layar adalah label ganda, dan yang ini berada di paling
      bawah isi gulir - jadi untuk keluar pengguna harus menggulir melewati peta,
      metrik, lap, kalori, dan 10 tombol RPE. Yang di bilah atas tidak ikut
      digulir, jadi selalu ada; yang ini tidak punya alasan untuk tetap ada.

      Tombol Hapus (dipindahkan dari Riwayat, T-10) ada di bawah, kecil dan
      berwarna danger - sengaja bukan tombol setara dengan GPX.
    -->
    <Button
        android:id="@+id/btnShare"
        style="@style/ActionBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_action_h"
        android:layout_marginTop="@dimen/gap_loose"
        android:text="@string/btn_share_gpx" />

    <Button
        android:id="@+id/btnDelete"
        style="@style/TinyBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_action_h"
        android:layout_marginTop="@dimen/gap_tight"
        android:layout_marginBottom="@dimen/gap_wide"
        android:gravity="center"
        android:text="@string/delete"
        android:textColor="@color/danger"
        android:textSize="@dimen/text_caption" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Ringkasan setelah gowes: rute + angka akhir + bagikan GPX. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <!--
      Isi dibungkus ScrollView + fillViewport. Alasannya TERUKUR, bukan selera:
      tinggi TETAP layar ini ≈ 484dp (dihitung dari dimens: judul + tanggal + kartu
      metrik + 3 tombol), sedangkan layar landscape ponsel hanya 360-400dp. Sebelum
      ini satu-satunya elemen elastis adalah peta (berat 1), jadi di layar pendek
      peta mengecil sampai nol SEMENTARA tombol STRAVA / Bagikan kartu / Bagikan GPX /
      TUTOP terdorong keluar layar — TUTUP tidak bisa dijangkau sama sekali.

      fillViewport menjaga berat 1 tetap bekerja di layar tinggi (peta mengisi ruang
      sisa), dan minHeight di peta mencegah ia kolaps total di layar pendek.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_edge"
        android:paddingRight="@dimen/screen_edge"
        android:paddingTop="@dimen/gap_loose">

    <TextView
        style="@style/SectionLabelAccent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/summary_title" />

    <TextView
        android:id="@+id/tvWhen"
        style="@style/EmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/gap_loose" />

    <id.cyclocomp.TileMapView
        android:id="@+id/route"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/route_map_min"
        android:background="@drawable/bg_card" />

    <!-- angka utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap_roomy"
        android:paddingBottom="@dimen/gap_roomy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_distance" />
                <TextView android:id="@+id/tvDist" style="@style/ValueBig"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0,00" />
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_moving" />
                <TextView android:id="@+id/tvMoving" style="@style/ValueBig"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0:00:00" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
            android:layout_marginTop="@dimen/gap_loose" android:layout_marginBottom="@dimen/gap_loose"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_avg" />
                <TextView android:id="@+id/tvAvg" style="@style/ValueSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0,0" />
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_max" />
                <TextView android:id="@+id/tvMax" style="@style/ValueSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0,0" />
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_elev" />
                <TextView android:id="@+id/tvElev" style="@style/ValueSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
            android:layout_marginTop="@dimen/gap_loose" android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/gap_loose">

            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/label_total" />
            <TextView android:id="@+id/tvTotal"
                style="@style/ValueSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingLeft="@dimen/gap_cozy" android:tag="num" android:text="0:00:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- lap -->
    <LinearLayout
        android:id="@+id/lapWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_roomy"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLapCount"
            style="@style/SectionLabelAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Baris lap dibuat di kode dan masuk ke sini. Sengaja dipisah dari kartu
             lapWrap supaya header tvLapCount tidak ikut terbuang saat daftar dibersihkan. -->
        <LinearLayout
            android:id="@+id/lapRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Kartu gambar adalah jalur utama (paling sering dipakai untuk dibagikan),
         jadi dapat baris sendiri selebar penuh. GPX dan Tutup di baris berikutnya. -->
    <Button
        android:id="@+id/btnStrava"
        style="@style/ActionBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_action_h"
        android:layout_marginTop="@dimen/gap_roomy"
        android:text="@string/btn_strava_upload" />

    <Button
        android:id="@+id/btnShareCard"
        style="@style/ActionBtnPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_action_h"
        android:layout_marginTop="@dimen/gap_loose"
        android:text="@string/btn_share_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/gap_loose"
        android:paddingBottom="@dimen/gap_wide">

        <Button
            android:id="@+id/btnShare"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1.7"
            android:layout_height="@dimen/btn_action_h"
            android:text="@string/btn_share_gpx" />

        <Button
            android:id="@+id/btnClose"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_action_h"
            android:layout_marginLeft="@dimen/gap_loose"
            android:text="@string/close" />
    </LinearLayout>
    </LinearLayout>
</ScrollView>

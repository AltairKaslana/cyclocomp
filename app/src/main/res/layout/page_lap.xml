<?xml version="1.0" encoding="utf-8"?>
<!--
  Halaman 3 "LAP" - gaya Strava: kartu lap berjalan (jarak + waktu besar)
  dengan kartu kecil di bawahnya, lalu daftar lap selesai.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_edge"
    android:paddingRight="@dimen/screen_edge">

    <TextView
        android:id="@+id/tvLapTitle"
        style="@style/SectionLabelAccent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/gap_snug"
        android:paddingBottom="@dimen/gap_normal"
        android:text="@string/lap_current" />

    <!-- kartu lap berjalan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap_roomy"
        android:paddingBottom="@dimen/gap_roomy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_distance" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvLapDist" style="@style/ValueBig"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,00"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_km" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_lap_time" />
                <TextView android:id="@+id/tvLapTime" style="@style/ValueBig"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0:00" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
            android:layout_marginLeft="@dimen/screen_edge" android:layout_marginRight="@dimen/screen_edge"
            android:layout_marginTop="@dimen/gap_loose" android:layout_marginBottom="@dimen/gap_loose"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_lap_avg" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView android:id="@+id/tvLapAvg" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,0"/>
                    <TextView style="@style/ValueUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/gap_tight"
                        android:text="@string/unit_speed" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_lap_small"
                android:layout_gravity="center_vertical" android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/label_lap_moving" />
                <TextView android:id="@+id/tvLapMoving" style="@style/ValueSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight" android:tag="num" android:text="0:00" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/screen_edge"
        android:paddingBottom="@dimen/gap_cozy"
        android:text="@string/lap_done" />

    <!--
      Kartu "LAP SELESAI" (T-08b).

      Tingginya diatur dari kode lewat applyLapCardMode(): kalau belum ada lap
      yang selesai, kartunya mengecil pas di sekeliling pesan kosongnya; kalau
      sudah ada isi, ia mengisi ruang yang tersisa supaya daftarnya bisa
      digulir sendiri.

      Kenapa tidak cukup wrap_content di XML: ListView dengan tinggi wrap_content
      di dalam LinearLayout vertikal akan mengukur SELURUH barisnya. Dengan
      banyak lap, isi halaman meluber keluar layar dan tidak ada yang bisa
      digulir - daftarnya tidak lagi bisa digulir sendiri. Jadi tinggi yang
      terbatas (weight=1) tetap perlu saat ada isi, dan hanya dibuang saat
      kosong.
    -->
    <LinearLayout
        android:id="@+id/lapCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <ListView
            android:id="@+id/lapList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:paddingLeft="@dimen/screen_edge"
            android:paddingRight="@dimen/screen_edge" />

        <!--
          Pesan kosong. Ia ada DI DALAM kartu, bukan di bawahnya: dulu pesannya
          berdiri sendiri di luar kartu, jadi yang tampil adalah kartu kosong
          setinggi setengah layar plus satu baris teks di bawahnya - terbaca
          seperti ada yang rusak, bukan "belum ada data".
        -->
        <TextView
            android:id="@+id/lapEmpty"
            style="@style/EmptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/gap_wide"
            android:text="@string/lap_none"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

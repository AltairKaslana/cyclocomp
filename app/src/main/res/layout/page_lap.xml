<?xml version="1.0" encoding="utf-8"?>
<!--
  Halaman 3 "LAP": angka lap yang sedang berjalan (besar) + riwayat lap.
  Dipakai saat ingin tahu performa per segmen, misal tiap tanjakan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <TextView
        android:id="@+id/tvLapTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.2"
        android:paddingBottom="8dp"
        android:text="@string/lap_current"
        android:textColor="@color/label"
        android:textSize="12sp" />

    <!-- lap berjalan: jarak dominan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_distance" />
            <TextView
                android:id="@+id/tvLapDist"
                style="@style/ValueBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_lap_time" />
            <TextView
                android:id="@+id/tvLapTime"
                style="@style/ValueBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_lap_avg" />
            <TextView
                android:id="@+id/tvLapAvg"
                style="@style/ValueSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_lap_moving" />
            <TextView
                android:id="@+id/tvLapMoving"
                style="@style/ValueSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.2"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:text="@string/lap_done"
        android:textColor="@color/label"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lapList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/label"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/lapEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/lap_none"
        android:textColor="@color/label"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>

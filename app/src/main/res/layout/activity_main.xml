<?xml version="1.0" encoding="utf-8"?>
<!--
  Susunan vertikal (bukan posisi mengambang) supaya tidak ada elemen yang saling
  menimpa di ukuran layar apa pun:

    [ bilah status + tombol kecil ]
    [ wadah halaman (berat 1)     ]
    [ titik indikator             ]
    [ tombol aksi                 ]

  Ketiga halaman ditumpuk di satu FrameLayout; HANYA SATU yang terlihat, sisanya
  GONE (diatur di MainActivity.initPages/showPage).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== bilah status ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvStatus"
            style="@style/StatusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLapBadge"
            style="@style/StatusBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHistory"
            style="@style/TinyBtn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_history" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/TinyBtn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="2dp"
            android:text="@string/btn_settings" />
    </LinearLayout>

    <!-- ===== wadah halaman ===== -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page0"
            layout="@layout/page_glance"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page1"
            layout="@layout/page_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page2"
            layout="@layout/page_lap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ===== indikator halaman ===== -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="4dp" />

    <!-- ===== tombol aksi ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnLap"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="54dp"
            android:text="@string/btn_lap" />

        <Button
            android:id="@+id/btnStartPause"
            style="@style/ActionBtnPrimary"
            android:layout_width="0dp"
            android:layout_weight="1.35"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/btnStop"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1.1"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:text="@string/btn_stop" />
    </LinearLayout>
</LinearLayout>

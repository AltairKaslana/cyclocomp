<?xml version="1.0" encoding="utf-8"?>
<!--
  Gaya Strava: bilah atas tipis, konten berkartu, aksi berbentuk kapsul.

    [ ● MEREKAM        LAP 1     RIWAYAT  PENGATURAN ]
    [            wadah halaman (berat 1)             ]
    [              — ● ·  (indikator)                ]
    [  ( LAP )      ( MULAI )       ( STOP )         ]

  Hanya satu halaman terlihat pada satu waktu; visibility diatur MainActivity.

  Tombol RIWAYAT/PENGATURAN sengaja 48dp (bukan 40dp): ambang target sentuh
  aksesibilitas. Di atas sepeda yang bergerak, 40dp terlalu kecil untuk dijangkau
  tanpa melihat layar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== bilah atas ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/gap_wide"
        android:paddingRight="@dimen/gap_snug">

        <View
            android:id="@+id/vRec"
            android:layout_width="@dimen/rec_dot"
            android:layout_height="@dimen/rec_dot"
            android:layout_marginRight="@dimen/rec_dot"
            android:background="@drawable/rec_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/StatusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLapBadge"
            style="@style/StatusBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/gap_cozy"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHistory"
            style="@style/TinyBtn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/btn_history" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/TinyBtn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/btn_settings" />
    </LinearLayout>

    <!-- ===== wadah halaman ===== -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page0"
            layout="@layout/page_glance"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page1"
            layout="@layout/page_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page2"
            layout="@layout/page_lap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ===== indikator halaman ===== -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="@dimen/gap_snug"
        android:paddingBottom="@dimen/gap_loose" />

    <!-- ===== tombol aksi =====
         Berat 1 : 1,5 : 1 — tombol MULAI terbesar, sesuai hukum Fitts: yang paling
         sering ditekan dapat wilayah paling luas. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/screen_edge"
        android:paddingRight="@dimen/screen_edge"
        android:paddingBottom="@dimen/gap_wide">

        <Button
            android:id="@+id/btnLap"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_action_h"
            android:text="@string/btn_lap" />

        <Button
            android:id="@+id/btnStartPause"
            style="@style/ActionBtnPrimary"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="@dimen/btn_action_h"
            android:layout_marginLeft="@dimen/gap_loose"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/btnStop"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_action_h"
            android:layout_marginLeft="@dimen/gap_loose"
            android:text="@string/btn_stop" />
    </LinearLayout>
</LinearLayout>

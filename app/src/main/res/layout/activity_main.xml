<?xml version="1.0" encoding="utf-8"?>
<!--
  Gaya Strava: bilah atas tipis, konten berkartu, aksi berbentuk kapsul.

    [ ● MEREKAM        LAP 1     RIWAYAT  PENGATURAN ]
    [            wadah halaman (berat 1)             ]
    [              — ● ·  (indikator)                ]
    [  ( LAP )      ( MULAI )       ( STOP )         ]

  Hanya satu halaman terlihat pada satu waktu; visibility diatur MainActivity.

  Tombol RIWAYAT/PENGATURAN sengaja 48dp (bukan 40dp): ambang target sentuh
  aksesibilitas. Di atas sepeda yang bergerak, 40dp terlalu kecil untuk dijangkau
  tanpa melihat layar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== bilah atas ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/gap_wide"
        android:paddingRight="@dimen/gap_snug">

        <View
            android:id="@+id/vRec"
            android:layout_width="@dimen/rec_dot"
            android:layout_height="@dimen/rec_dot"
            android:layout_marginRight="@dimen/rec_dot"
            android:background="@drawable/rec_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/StatusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLapBadge"
            style="@style/StatusBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/gap_cozy"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <!--
          Saat IDLE: dua ikon - Riwayat dan Pengaturan.
          Saat MEREKAM / DIJEDA: keduanya disembunyikan dan digantikan satu
          ikon gembok non-aktif (btnLock). Logikanya di MainActivity.refresh().

          Kenapa digembok, bukan cuma setEnabled(false): tombol mati yang
          masih terlihat membuat orang mencoba mengkliknya - dan menekan
          sesuatu yang tidak bereaksi terlihat seperti bug. Satu gembok yang
          jelas "terkunci" menjelaskan diri sendiri.
        -->
        <ImageButton
            android:id="@+id/btnHistory"
            style="@style/IconBtn"
            android:contentDescription="@string/btn_history"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/IconBtn"
            android:layout_marginLeft="@dimen/gap_tight"
            android:contentDescription="@string/btn_settings"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnMap"
            style="@style/IconBtn"
            android:layout_marginLeft="@dimen/gap_tight"
            android:contentDescription="@string/group_map"
            android:src="@drawable/ic_map" />

        <ImageButton
            android:id="@+id/btnLock"
            style="@style/IconBtn"
            android:contentDescription="@string/lock_locked"
            android:enabled="false"
            android:src="@drawable/ic_lock"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== wadah halaman ===== -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page0"
            layout="@layout/page_glance"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page1"
            layout="@layout/page_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page2"
            layout="@layout/page_lap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ===== indikator halaman ===== -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="@dimen/gap_snug"
        android:paddingBottom="@dimen/gap_loose" />

    <!-- ===== tombol aksi =====
         Berat 1 : 1,5 : 1 — tombol MULAI terbesar, sesuai hukum Fitts: yang paling
         sering ditekan dapat wilayah paling luas. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/screen_edge"
        android:paddingRight="@dimen/screen_edge"
        android:paddingBottom="@dimen/gap_wide">

        <Button
            android:id="@+id/btnLap"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_action_h"
            android:text="@string/btn_lap" />

        <Button
            android:id="@+id/btnStartPause"
            style="@style/ActionBtnPrimary"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="@dimen/btn_action_h"
            android:layout_marginLeft="@dimen/gap_loose"
            android:text="@string/btn_start" />

        <!--
          BERHENTI: jalur bahaya (garis danger), bukan isi aksen. Tombol ini
          mengakhiri perjalanan, jadi harus terbaca sebagai jalur keluar - bukan
          sekadar aksi biasa yang sama bobotnya dengan LAP.

          T-08 - dibungkus FrameLayout supaya bar progres tahan-untuk-berhenti
          bisa diletakkan di dasar tombol. Button adalah TextView: ia tidak bisa
          punya anak, jadi progres harus bertumpuk di LUAR tombolnya. Karena itu
          latar (garis danger) pindah ke FrameLayout, dan Button di atasnya hanya
          mengurus teks dengan latar transparan (ActionBtnDangerText).

          clipToOutline memotong bar progres mengikuti sudut kapsul tombol.
          Tanpa itu bar yang lurus akan menonjol keluar dari sudut yang bulat di
          kedua ujung bawah.
        -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/btn_action_h"
            android:layout_marginLeft="@dimen/gap_loose"
            android:background="@drawable/bg_btn_danger"
            android:clipToOutline="true">

            <View
                android:id="@+id/vStopProgress"
                android:layout_width="0dp"
                android:layout_height="@dimen/hold_bar_h"
                android:layout_gravity="bottom"
                android:background="@color/danger" />

            <Button
                android:id="@+id/btnStop"
                style="@style/ActionBtnDangerText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/btn_stop" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Gaya Strava: bilah atas tipis, konten berkartu, aksi berbentuk kapsul.

    [ ● MEREKAM        LAP 1     RIWAYAT  PENGATURAN ]
    [            wadah halaman (berat 1)             ]
    [              — ● ·  (indikator)                ]
    [  ( LAP )      ( MULAI )       ( STOP )         ]

  Hanya satu halaman terlihat pada satu waktu; visibility diatur MainActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== bilah atas ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="4dp">

        <View
            android:id="@+id/vRec"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginRight="7dp"
            android:background="@drawable/rec_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/StatusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLapBadge"
            style="@style/StatusBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHistory"
            style="@style/TinyBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_history" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/TinyBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_settings" />
    </LinearLayout>

    <!-- ===== wadah halaman ===== -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page0"
            layout="@layout/page_glance"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page1"
            layout="@layout/page_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page2"
            layout="@layout/page_lap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ===== indikator halaman ===== -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="10dp" />

    <!-- ===== tombol aksi ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnLap"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="@string/btn_lap" />

        <Button
            android:id="@+id/btnStartPause"
            style="@style/ActionBtnPrimary"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/btnStop"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:text="@string/btn_stop" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Halaman 1 "SEKILAS" - gaya Strava.
  Kecepatan sebagai angka dominan (putih, Barlow Condensed), pil tanjakan di
  atasnya, lalu satu kartu berisi tiga metrik berkunci dengan pembatas tipis.

  Catatan: pil ini dulu dikomentari "gradien" padahal isinya warna solid. Sekarang
  memang ada gradien berupa bentuk — lihat GradeRoad, yang menggambar garis jalan
  miring sesuai sudut tanjakan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_edge"
    android:paddingRight="@dimen/screen_edge">

    <!-- pil tanjakan: ruas jalan miring + angka. Arah dan besar tanjakan terbaca
         dari bentuk jalan; angkanya memberi nilai persis. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/pill_h"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/gap_cozy"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/gap_roomy"
        android:paddingRight="@dimen/gap_roomy">

        <id.cyclocomp.GradeRoad
            android:id="@+id/gradeRoad"
            android:layout_width="@dimen/grade_road_w"
            android:layout_height="@dimen/grade_road_h"
            android:layout_marginRight="@dimen/gap_snug"
            android:contentDescription="@string/grade_road_desc" />

        <TextView
            android:id="@+id/tvGrade"
            style="@style/GradeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/gap_snug"
            android:tag="num"
            android:text="0,0" />

        <TextView
            style="@style/GradeUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/gap_tight"
            android:text="@string/unit_grade" />

        <!-- detak jantung: muncul hanya kalau sensor mengirim data -->
        <TextView
            android:id="@+id/tvHrHeart"
            style="@style/PillGlyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/gap_loose"
            android:text="\u2665"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHr"
            style="@style/GradeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/gap_tight"
            android:tag="num"
            android:text="0"
            android:visibility="gone" />
    </LinearLayout>

    <!-- kecepatan: angka dominan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <id.cyclocomp.AutoFitText
            android:id="@+id/tvSpeed"
            style="@style/SpeedHero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:tag="num"
            android:text="0,0" />

        <TextView
            style="@style/SpeedUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:text="@string/unit_speed" />
    </LinearLayout>

    <!-- kartu tiga metrik kunci -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/metrics_card_h"
        android:layout_marginBottom="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/lblS0" android:text="@string/label_distance" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_snug"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">
                <TextView android:id="@+id/tvDist" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,00"/>
                <TextView style="@style/ValueUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/gap_tight"
                    android:id="@+id/unS0" android:text="@string/unit_km" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_short"
            android:layout_gravity="center_vertical" android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/lblS1" android:text="@string/label_time" />
            <TextView android:id="@+id/tvTime" style="@style/ValueSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_snug" android:tag="num" android:text="0:00:00" />
            <TextView android:id="@+id/unS1" style="@style/ValueUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/gap_tight"
                android:visibility="gone" />
        </LinearLayout>

        <View android:layout_width="@dimen/hairline" android:layout_height="@dimen/divider_short"
            android:layout_gravity="center_vertical" android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/lblS2" android:text="@string/label_avg" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_snug"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">
                <TextView android:id="@+id/tvAvg" style="@style/ValueSmall"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="num" android:text="0,0"/>
                <TextView style="@style/ValueUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/gap_tight"
                    android:id="@+id/unS2" android:text="@string/unit_speed" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- N-10: panduan rute impor. Muncul hanya saat gowes berjalan DAN ada rute;
         selama tampil, peta live di bawahnya disembunyikan - dua panel rute
         sekaligus memakan ruang kecepatan tanpa menambah informasi.

         AKSESIBILITAS: kartu ini diberi SATU kalimat lengkap lewat
         contentDescription di MainActivity.updateNav, jadi semua anaknya
         ditandai importantForAccessibility="no". Tanpa itu TalkBack membaca
         kalimat itu lalu mengulang potongannya ("120", "m", "Sisa 8.50 km"). -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_loose"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_normal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <id.cyclocomp.TurnArrow
                android:id="@+id/navArrow"
                android:layout_width="@dimen/nav_arrow"
                android:layout_height="@dimen/nav_arrow"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/navTurnDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/gap_normal"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:tag="num"
                android:textColor="@color/value"
                android:textSize="@dimen/text_value_s" />

            <TextView
                android:id="@+id/navTurnDistUnit"
                style="@style/ValueUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/gap_tight"
                android:importantForAccessibility="no"
                android:text="@string/unit_m"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Warna teks berubah merah saat di luar rute (diatur di kode);
                 bentuk/warna bukan satu-satunya penanda karena kalimatnya juga
                 berubah jadi "Di luar rute". -->
            <TextView
                android:id="@+id/navRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/label"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <id.cyclocomp.NavRibbon
            android:id="@+id/navRibbon"
            android:layout_width="match_parent"
            android:layout_height="@dimen/glance_nav_h"
            android:layout_marginTop="@dimen/gap_normal"
            android:contentDescription="@string/nav_route_desc"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Peta live: rute yang sudah dilalui, di bawah kartu metrik (angka km).
         TileMapView = ubin OSM di belakang garis rute; kalau tile gagal (offline),
         latar kisi dari RouteView tetap tampil. Disembunyikan sampai gowes dimulai. -->
    <id.cyclocomp.TileMapView
        android:id="@+id/liveMap"
        android:layout_width="match_parent"
        android:layout_height="@dimen/glance_map_h"
        android:layout_marginBottom="@dimen/gap_loose"
        android:contentDescription="@string/route_live_desc"
        android:visibility="gone" />
</LinearLayout>

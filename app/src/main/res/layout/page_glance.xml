<?xml version="1.0" encoding="utf-8"?>
<!--
  Halaman 1 "SEKILAS": satu angka dominan (kecepatan) + 3 metrik kunci.
  Inilah halaman yang dilihat saat gowes - hierarki jelas, angka besar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <!-- kecepatan: angka dominan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="0,0"
            android:textColor="@color/accent"
            android:textSize="118sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/unit_speed"
            android:textColor="@color/label"
            android:textSize="16sp"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <!-- gradien: dibaca sebagai arah tanjakan, bukan angka biasa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGradeArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/value"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:paddingLeft="6dp"
            android:text="0,0"
            android:textColor="@color/value"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:paddingLeft="4dp"
            android:text="@string/unit_grade"
            android:textColor="@color/label"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 3 metrik kunci, sejajar rapi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_distance" />
            <TextView android:id="@+id/tvDist" style="@style/ValueSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_time" />
            <TextView android:id="@+id/tvTime" style="@style/ValueSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_avg" />
            <TextView android:id="@+id/tvAvg" style="@style/ValueSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
